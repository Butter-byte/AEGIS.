{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Aegis AI Diagnosis Module Output",
  "type": "object",
  "required": ["schema_version", "output_id", "generated_at", "incident", "network_summary", "diagnosis", "recovery_plan_groups", "ranking", "digital_twin_handoff"],
  "properties": {
    "schema_version": {"type": "string", "const": "1.0"},
    "output_id": {"type": "string"},
    "generated_at": {"type": "string", "format": "date-time"},
    "incident": {"$ref": "#/$defs/incident"},
    "network_summary": {"$ref": "#/$defs/networkSummary"},
    "diagnosis": {"$ref": "#/$defs/diagnosis"},
    "recovery_plan_groups": {"type": "array", "items": {"$ref": "#/$defs/planGroup"}},
    "ranking": {"$ref": "#/$defs/ranking"},
    "digital_twin_handoff": {"$ref": "#/$defs/twinHandoff"},
    "data_quality": {"type": "object"}
  },
  "$defs": {
    "incident": {"type": "object", "required": ["incident_id", "severity", "status"], "properties": {"incident_id": {"type": "string"}, "severity": {"type": "string"}, "status": {"type": "string"}}},
    "networkSummary": {"type": "object", "required": ["headline", "status", "executive_summary"], "properties": {"headline": {"type": "string"}, "status": {"enum": ["healthy", "warning", "critical"]}, "executive_summary": {"type": "string"}, "affected_services": {"type": "array", "items": {"type": "string"}}}},
    "diagnosis": {"type": "object", "required": ["most_likely_root_cause", "hypotheses"], "properties": {"most_likely_root_cause": {"$ref": "#/$defs/hypothesis"}, "hypotheses": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/hypothesis"}}}},
    "hypothesis": {"type": "object", "required": ["diagnosis_id", "root_cause", "confidence_score", "confidence", "supporting_evidence"], "properties": {"diagnosis_id": {"type": "string"}, "root_cause": {"type": "string"}, "confidence_score": {"type": "number", "minimum": 0, "maximum": 1}, "confidence": {"enum": ["low", "medium", "high"]}, "affected_targets": {"type": "array", "items": {"type": "string"}}, "explanation": {"type": "string"}, "supporting_evidence": {"type": "array", "items": {"type": "string"}}, "contradicting_evidence": {"type": "array", "items": {"type": "string"}}, "next_checks": {"type": "array", "items": {"type": "string"}}}},
    "planGroup": {"type": "object", "required": ["diagnosis_id", "plans"], "properties": {"diagnosis_id": {"type": "string"}, "plans": {"type": "array", "minItems": 2, "maxItems": 5, "items": {"$ref": "#/$defs/plan"}}}},
    "plan": {"type": "object", "required": ["plan_id", "title", "objective", "rationale", "explanation", "risk", "actions", "preconditions", "verification", "stop_conditions", "rollback"], "properties": {"plan_id": {"type": "string"}, "title": {"type": "string"}, "objective": {"type": "string"}, "rationale": {"type": "string"}, "explanation": {"type": "string"}, "risk": {"enum": ["low", "medium", "high"]}, "requires_human_approval": {"type": "boolean"}, "actions": {"type": "array", "items": {"$ref": "#/$defs/action"}}, "preconditions": {"type": "array", "items": {"type": "string"}}, "verification": {"type": "array", "items": {"type": "string"}}, "stop_conditions": {"type": "array", "items": {"type": "string"}}, "rollback": {"type": "array", "items": {"$ref": "#/$defs/action"}}, "llm_grounding_data": {"type": "object"}}},
    "action": {"type": "object", "required": ["operation", "target", "parameters"], "properties": {"operation": {"type": "string"}, "target": {"type": "string"}, "parameters": {"type": "object"}}},
    "ranking": {"type": "object", "required": ["algorithm_version", "weights", "ranked_plans"], "properties": {"algorithm_version": {"type": "string"}, "weights": {"type": "object", "additionalProperties": {"type": "number"}}, "ranked_plans": {"type": "array", "items": {"$ref": "#/$defs/rankedPlan"}}}},
    "rankedPlan": {"type": "object", "required": ["plan_id", "eligible", "reason"], "properties": {"plan_id": {"type": "string"}, "rank": {"type": "integer", "minimum": 1}, "eligible": {"type": "boolean"}, "final_score": {"type": ["number", "null"], "minimum": 0, "maximum": 100}, "reason": {"type": "string"}, "score_breakdown": {"type": "object"}, "estimate_source": {"enum": ["digital_twin_estimate", "fallback_demo_estimate"]}}},
    "twinHandoff": {"type": "object", "required": ["status", "plans_to_simulate", "execution_rule"], "properties": {"status": {"enum": ["pending_simulation", "simulation_complete"]}, "plans_to_simulate": {"type": "array", "items": {"type": "string"}}, "execution_rule": {"type": "string"}, "simulation_context": {"type": "object"}}}
  }
}
