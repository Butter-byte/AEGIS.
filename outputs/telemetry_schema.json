{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Aegis Telemetry Input",
  "type": "object",
  "required": ["schema_version", "generated_at", "incident", "nodes"],
  "properties": {
    "schema_version": {"type": "string"},
    "message_id": {"type": "string"},
    "generated_at": {"type": "string", "format": "date-time"},
    "incident": {"$ref": "#/$defs/incident"},
    "collection_window": {"$ref": "#/$defs/window"},
    "nodes": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/node"}},
    "links": {"type": "array", "items": {"$ref": "#/$defs/link"}},
    "services": {"type": "array", "items": {"type": "object"}},
    "events": {"type": "array", "items": {"type": "object"}},
    "data_quality": {"type": "object"}
  },
  "$defs": {
    "incident": {"type": "object", "required": ["incident_id", "status", "severity"], "properties": {"incident_id": {"type": "string"}, "status": {"type": "string"}, "severity": {"type": "string"}}},
    "window": {"type": "object", "properties": {"start": {"type": "string", "format": "date-time"}, "end": {"type": "string", "format": "date-time"}, "sample_interval_seconds": {"type": "number", "minimum": 1}}},
    "node": {"type": "object", "required": ["node_id", "node_type", "telemetry"], "properties": {"node_id": {"type": "string"}, "name": {"type": "string"}, "node_type": {"type": "string"}, "health": {"type": "object"}, "telemetry": {"$ref": "#/$defs/telemetry"}, "interfaces": {"type": "array", "items": {"$ref": "#/$defs/interface"}}}},
    "telemetry": {"type": "object", "properties": {"cpu": {"type": "object", "properties": {"usage_percent": {"type": "number", "minimum": 0, "maximum": 100}}}, "memory": {"type": "object", "properties": {"usage_percent": {"type": "number", "minimum": 0, "maximum": 100}, "available_mb": {"type": "number", "minimum": 0}}}, "network": {"type": "object"}}},
    "interface": {"type": "object", "required": ["interface_id", "admin_status", "oper_status"], "properties": {"interface_id": {"type": "string"}, "admin_status": {"enum": ["up", "down"]}, "oper_status": {"enum": ["up", "down", "unknown"]}, "capacity_mbps": {"type": "number", "minimum": 0}}},
    "link": {"type": "object", "required": ["link_id", "source_node_id", "destination_node_id", "status"], "properties": {"link_id": {"type": "string"}, "source_node_id": {"type": "string"}, "destination_node_id": {"type": "string"}, "status": {"enum": ["healthy", "degraded", "down", "unknown"]}}}
  }
}
